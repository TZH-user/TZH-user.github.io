---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, tags, period, metrics, sourceRepo, sourceRepoCN, report, cover, coverAlt, copyrightNote, repoNote } = project.data;

const hasLinks = Boolean(sourceRepo || sourceRepoCN || report || repoNote);
---

<BaseLayout title={title} description={summary} heroImage={cover}>
  <article class="mx-auto max-w-5xl px-4 py-10 sm:py-14">
    <!-- ① 一句话定位 + 技术栈 -->
    <header>
      <p class="kicker">/projects/{project.id}</p>
      <h1 class="mt-3 text-3xl font-bold text-balance sm:text-4xl">{title}</h1>
      <p class="mt-4 max-w-3xl text-[15px] leading-8 text-fg-300">{summary}</p>
      <div class="mt-5 flex flex-wrap items-center gap-1.5">
        {tags.map((t) => <span class="tag">{t}</span>)}
        <span class="tag border-amb-500/40 text-amb-400">{period}</span>
      </div>
    </header>

    <!-- 量化指标条 -->
    {
      metrics.length > 0 && (
        <dl class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
          {metrics.map((m) => (
            <div class="stat-cell">
              <dd class="font-mono text-lg text-amb-400">{m.value}</dd>
              <dt class="mt-1 text-xs text-fg-500">{m.label}</dt>
            </div>
          ))}
        </dl>
      )
    }

    {
      cover && (
        <figure class="mt-8">
          <img
            src={cover}
            alt={coverAlt ?? `${title} 配图`}
            width={1200}
            height={640}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full rounded-xl border border-ink-700 bg-white/95 p-2"
          />
        </figure>
      )
    }

    <!-- 正文（背景/架构/亮点/演示/成果 按 md 内小节组织） -->
    <div class="prose-md mt-4">
      <Content />
    </div>

    <!-- ⑦ 相关资源 -->
    {
      hasLinks && (
        <section class="mt-12 panel p-5" aria-label="相关资源">
          <h2 class="text-lg font-semibold text-fg-100">相关资源</h2>
          <ul class="mt-4 flex flex-wrap gap-3">
            {sourceRepo && (
              <li>
                <a href={sourceRepo} target="_blank" rel="noopener noreferrer" class="inline-flex h-11 items-center rounded-lg border border-ink-600 px-5 text-sm text-fg-100 hover:border-phos-600/60">
                  GitHub 仓库 ↗
                </a>
              </li>
            )}
            {sourceRepoCN && (
              <li>
                <a href={sourceRepoCN} target="_blank" rel="noopener noreferrer" class="inline-flex h-11 items-center rounded-lg border border-ink-600 px-5 text-sm text-fg-100 hover:border-phos-600/60">
                  Gitee 镜像 ↗
                </a>
              </li>
            )}
            {report && (
              <li>
                <a href={report} target="_blank" rel="noopener noreferrer" class="inline-flex h-11 items-center gap-2 rounded-lg bg-ink-800 px-5 text-sm text-phos-300 hover:bg-ink-700">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 1.5A1.5 1.5 0 0 1 5.5 0h4.086a1.5 1.5 0 0 1 1.06.44l2.415 2.414A1.5 1.5 0 0 1 13.5 3.914V14.5A1.5 1.5 0 0 1 12 16H5.5A1.5 1.5 0 0 1 4 14.5v-13Z"/></svg>
                  查看验证报告 (PDF)
                </a>
              </li>
            )}
          </ul>
          {repoNote && <p class="mt-4 text-xs leading-6 text-fg-500">{repoNote}</p>}
        </section>
      )
    }

    {copyrightNote && (
      <p class="mt-8 rounded-lg border border-amb-500/30 bg-amb-500/5 px-4 py-3 text-xs leading-6 text-fg-500">
        ⚖ 版权说明：{copyrightNote}
      </p>
    )}

    <nav class="mt-10 flex items-center justify-between border-t border-ink-700/60 pt-6" aria-label="分页">
      <a href="/projects/" class="inline-flex h-11 items-center text-sm text-sig-400 hover:text-sig-500">← 返回项目列表</a>
      <a href="/" class="inline-flex h-11 items-center text-sm text-fg-500 hover:text-fg-100">回首页</a>
    </nav>
  </article>
</BaseLayout>
