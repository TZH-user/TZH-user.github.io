---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="页面不存在">
  <section class="scope-grid mx-auto flex max-w-5xl flex-col items-center px-4 py-24 text-center">
    <p class="font-mono text-7xl font-bold text-phos-400">404</p>
    <p class="mt-4 font-mono text-sm text-fg-500">$ find / -name "该页面" 2>/dev/null</p>
    <p class="mt-2 font-mono text-sm text-fg-300">find: 没有那个文件或目录</p>
    <a
      href="/"
      class="mt-8 inline-flex h-12 items-center rounded-lg bg-phos-500 px-6 font-semibold text-ink-950 hover:bg-phos-400"
    >
      返回首页
    </a>
  </section>
</BaseLayout>
