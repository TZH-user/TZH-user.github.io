---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';

const projects = await getCollection('projects');
const featured = projects
  .filter((p) => p.data.tier === 'featured')
  .sort((a, b) => a.data.weight - b.data.weight);

const skills = [
  { area: 'MCU / 固件', items: ['STM32H743', 'FreeRTOS', 'HAL/CubeMX', 'CMake + Ninja', 'CMSIS-DSP'] },
  { area: 'FPGA / 数字', items: ['Verilog', 'Quartus', 'CIC / FIR', '定点化建模', 'MATLAB 金模型'] },
  { area: '显示与界面', items: ['LVGL', 'LTDC/FMC', '触摸驱动', 'SDRAM'] },
  { area: 'PC / 自动化', items: ['Python', 'FastAPI', 'SCPI 仪器控制', 'Electron', 'MCP 开发'] },
  { area: 'AI 工具链', items: ['ComfyUI', 'Flux/Wan2.2/H3', 'GGUF 量化', '素材管线脚本'] },
  { area: '协作与质量', items: ['Git', '单元测试', '验收文档', 'AI 多智能体调度'] },
];
---

<BaseLayout heroImage="/assets/covers/signal-analyzer.webp">
  <!-- Hero -->
  <section class="scope-grid border-b border-ink-700/80">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
      <p class="kicker">$ whoami</p>
      <h1 class="mt-3 text-3xl font-bold text-balance sm:text-5xl">
        {SITE.name}
        <span class="mt-2 block bg-gradient-to-r from-phos-300 via-phos-400 to-sig-400 bg-clip-text text-xl text-transparent sm:text-2xl">
          {SITE.tagline}
        </span>
      </h1>
      <p class="mt-5 max-w-2xl text-[15px] leading-8 text-fg-300">{SITE.intro}</p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="/projects/"
          class="inline-flex h-12 items-center rounded-lg bg-phos-500 px-6 font-semibold text-ink-950 transition-colors hover:bg-phos-400"
        >
          浏览项目 →
        </a>
        <a
          href="/about/"
          class="inline-flex h-12 items-center rounded-lg border border-ink-600 px-6 text-fg-100 transition-colors hover:border-phos-600/60"
        >
          关于我
        </a>
      </div>

      <dl class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="stat-cell">
          <dd class="font-mono text-2xl text-phos-400">8</dd>
          <dt class="mt-1 text-xs text-fg-500">在册项目</dt>
        </div>
        <div class="stat-cell">
          <dd class="font-mono text-2xl text-phos-400">4</dd>
          <dt class="mt-1 text-xs text-fg-500">带实测数据</dt>
        </div>
        <div class="stat-cell">
          <dd class="font-mono text-2xl text-phos-400">22+</dd>
          <dt class="mt-1 text-xs text-fg-500">规范提交（桌宠）</dt>
        </div>
        <div class="stat-cell">
          <dd class="font-mono text-2xl text-phos-400">11</dd>
          <dt class="mt-1 text-xs text-fg-500">种调制识别</dt>
        </div>
      </dl>
    </div>
  </section>

  <!-- 精选项目 -->
  <section class="mx-auto max-w-5xl px-4 py-14">
    <div class="flex items-end justify-between">
      <div>
        <p class="kicker">featured projects</p>
        <h2 class="mt-2 text-2xl font-bold sm:text-3xl">精选项目</h2>
      </div>
      <a href="/projects/" class="shrink-0 text-sm text-sig-400 hover:text-sig-500">全部项目 →</a>
    </div>
    <div class="mt-7 grid gap-5 sm:grid-cols-2">
      {featured.map((p, i) => <ProjectCard project={p} size="lg" eager={i === 0} />)}
    </div>
  </section>

  <!-- 技能矩阵 -->
  <section class="border-y border-ink-700/80 bg-ink-900/40">
    <div class="mx-auto max-w-5xl px-4 py-14">
      <p class="kicker">skill matrix</p>
      <h2 class="mt-2 text-2xl font-bold sm:text-3xl">技能矩阵</h2>
      <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          skills.map((s) => (
            <div class="panel p-4">
              <h3 class="font-mono text-sm text-phos-400">{s.area}</h3>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {s.items.map((it) => (
                  <li class="tag">{it}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 联系 -->
  <section class="mx-auto max-w-5xl px-4 py-14">
    <p class="kicker">contact</p>
    <h2 class="mt-2 text-2xl font-bold sm:text-3xl">联系我</h2>
    <p class="mt-3 max-w-2xl text-sm leading-7 text-fg-300">{SITE.wechatTip}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-11 items-center rounded-lg border border-ink-600 px-5 text-sm text-fg-100 hover:border-phos-600/60"
      >GitHub ↗</a>
      <a
        href={SITE.gitee}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-11 items-center rounded-lg border border-ink-600 px-5 text-sm text-fg-100 hover:border-phos-600/60"
      >Gitee ↗</a>
      <a
        href={SITE.email}
        class="inline-flex h-11 items-center rounded-lg border border-ink-600 px-5 text-sm text-fg-100 hover:border-phos-600/60"
      >邮箱</a>
    </div>
  </section>
</BaseLayout>
