---
import { SITE } from '../config';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-ink-700/80 bg-ink-900/60">
  <div class="mx-auto max-w-5xl px-4 py-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-mono text-sm text-fg-100">{SITE.name} · Portfolio</p>
        <p class="mt-2 max-w-md text-sm leading-relaxed text-fg-500">{SITE.tagline}</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 items-center gap-2 rounded-lg border border-ink-600 px-4 text-sm text-fg-300 hover:border-phos-600/60 hover:text-phos-300 transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
          GitHub
        </a>
        <a
          href={SITE.gitee}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 items-center gap-2 rounded-lg border border-ink-600 px-4 text-sm text-fg-300 hover:border-phos-600/60 hover:text-phos-300 transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true"><path d="M512 1024C229.2 1024 0 794.8 0 512S229.2 0 512 0s512 229.2 512 512-229.2 512-512 512z m259.2-569.6H480c-12.8 0-25.6 12.8-25.6 25.6v64c0 12.8 12.8 25.6 25.6 25.6h176c12.8 0 25.6 12.8 25.6 25.6v12.8c0 41.6-35.2 76.8-76.8 76.8h-240c-12.8 0-25.6-12.8-25.6-25.6V416c0-41.6 35.2-76.8 76.8-76.8h355.2c12.8 0 25.6-12.8 25.6-25.6v-64c0-12.8-12.8-25.6-25.6-25.6H416c-105.6 0-192 86.4-192 192v355.2c0 12.8 12.8 25.6 25.6 25.6h374.4c92.8 0 172.8-76.8 172.8-172.8v-144c0-12.8-12.8-25.6-25.6-25.6z"></path></svg>
          Gitee
        </a>
        <a
          href={SITE.email}
          class="inline-flex h-11 items-center rounded-lg border border-ink-600 px-4 text-sm text-fg-300 hover:border-phos-600/60 hover:text-phos-300 transition-colors"
        >
          邮箱
        </a>
      </div>
    </div>
    <div class="mt-6 flex flex-col gap-1 border-t border-ink-700/60 pt-4 text-xs text-fg-700 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.name} · 静态构建于 Astro</p>
      <p class="font-mono">build {new Date().toISOString().slice(0, 10)}</p>
    </div>
  </div>
</footer>
